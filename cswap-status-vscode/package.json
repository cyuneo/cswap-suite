{
  "name": "cswap-status",
  "displayName": "cswap Status",
  "description": "cswap 侧栏（活动栏图标）：当前机器、每个 claude-swap 账号的 5 小时/7 天用量圆环和一键切换、主账号、cswap 自动切换在做什么（阈值、当前结论、下一个账号、切换记录、暂停/恢复）、api-worker 每个 Console API key 的本月花费和任务；精简的状态栏条目；为所有账号保持 Claude Code 的 Dynamic workflows（Ultracode）开启；在 tmux 里启动 Claude 方便手机操作（cswap-remote）。",
  "version": "0.13.1",
  "publisher": "chenyu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cswapStatus.openPanel",
        "title": "打开侧栏",
        "category": "cswap"
      },
      {
        "command": "cswapStatus.switchAccount",
        "title": "切换到此账号",
        "category": "cswap",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "cswapStatus.dashboard",
        "title": "在终端打开 cswap 仪表盘",
        "category": "cswap",
        "icon": "$(dashboard)"
      },
      {
        "command": "cswapStatus.show",
        "title": "账号列表",
        "category": "cswap"
      },
      {
        "command": "cswapStatus.refresh",
        "title": "刷新",
        "category": "cswap",
        "icon": "$(refresh)"
      },
      {
        "command": "cswapStatus.startInTmux",
        "title": "在 tmux 里启动 Claude（手机可操作）",
        "category": "cswap",
        "icon": "$(device-mobile)"
      },
      {
        "command": "cswapStatus.continueInTmux",
        "title": "在 tmux 里接着上次的对话（手机可操作）",
        "category": "cswap"
      },
      {
        "command": "cswapStatus.addAccounts",
        "title": "从服务器添加账号（粘贴 setup-token，不用登录）",
        "category": "cswap",
        "icon": "$(cloud-download)"
      },
      {
        "command": "cswapStatus.autoThreshold",
        "title": "设置自动切换阈值…",
        "category": "cswap",
        "icon": "$(edit)"
      },
      {
        "command": "cswapStatus.autoPause",
        "title": "暂停自动切换",
        "category": "cswap",
        "icon": "$(debug-pause)"
      },
      {
        "command": "cswapStatus.autoResume",
        "title": "恢复自动切换",
        "category": "cswap",
        "icon": "$(debug-start)"
      },
      {
        "command": "cswapStatus.showApi",
        "title": "任务列表",
        "category": "API worker"
      },
      {
        "command": "cswapStatus.apiRefresh",
        "title": "刷新",
        "category": "API worker",
        "icon": "$(refresh)"
      },
      {
        "command": "cswapStatus.apiDispatch",
        "title": "派一个新任务",
        "category": "API worker",
        "icon": "$(add)"
      },
      {
        "command": "cswapStatus.apiOpenResult",
        "title": "查看结果",
        "category": "API worker"
      },
      {
        "command": "cswapStatus.apiCancel",
        "title": "停止任务",
        "category": "API worker"
      },
      {
        "command": "cswapStatus.apiClose",
        "title": "标记为已结束",
        "category": "API worker"
      },
      {
        "command": "cswapStatus.apiOpenSession",
        "title": "打开云端会话",
        "category": "API worker"
      },
      {
        "command": "cswapStatus.apiCollect",
        "title": "取回输出文件",
        "category": "API worker"
      },
      {
        "command": "cswapStatus.addAccount",
        "title": "添加账号",
        "category": "cswap",
        "icon": "$(add)"
      },
      {
        "command": "cswapStatus.accountEnable",
        "title": "启用（参加自动切换）",
        "category": "cswap"
      },
      {
        "command": "cswapStatus.accountDisable",
        "title": "停用（不参加自动切换）",
        "category": "cswap"
      },
      {
        "command": "cswapStatus.accountAlias",
        "title": "设置别名…",
        "category": "cswap"
      },
      {
        "command": "cswapStatus.accountLimits",
        "title": "切换上限…（用到多少 % 切走）",
        "category": "cswap"
      },
      {
        "command": "cswapStatus.accountReserveOn",
        "title": "设为主账号（其他账号到上限才用）",
        "category": "cswap"
      },
      {
        "command": "cswapStatus.accountReserveOff",
        "title": "取消主账号",
        "category": "cswap"
      },
      {
        "command": "cswapStatus.accountRelogin",
        "title": "重新登录…",
        "category": "cswap",
        "icon": "$(sign-in)"
      },
      {
        "command": "cswapStatus.accountRemove",
        "title": "删除账号…",
        "category": "cswap"
      },
      {
        "command": "cswapStatus.apiKeyAdd",
        "title": "添加 API key…",
        "category": "API worker",
        "icon": "$(add)"
      },
      {
        "command": "cswapStatus.apiKeyBudget",
        "title": "设置每月预算…",
        "category": "API worker"
      },
      {
        "command": "cswapStatus.apiKeyRemove",
        "title": "删除 key…",
        "category": "API worker"
      }
    ],
    "configuration": {
      "title": "cswap Status",
      "properties": {
        "cswapStatus.path": {
          "type": "string",
          "default": "",
          "description": "cswap 命令的路径。留空 = 先找 ~/.local/bin/cswap，再找 PATH 里的 cswap。",
          "scope": "machine"
        },
        "cswapStatus.keepWorkflowsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "为所有账号保持 Claude Code 的 Dynamic workflows（Ultracode 按钮）开启：~/.claude/settings.json 里没有 \"enableWorkflows\" 时加上 true。不会覆盖你自己设的 false 或 disableWorkflows。"
        },
        "cswapStatus.refreshSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "多久刷新一次（秒）。每次会运行 cswap policy list --json（只读本机的用量存储，不联网）和 api-worker list（有未完成的云端任务时会用 git ls-remote 联网查询）；设置了 satelliteServer 时，每 5 分钟还会通过 SSH 从服务器同步一次用量。"
        },
        "cswapStatus.satelliteServer": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "只在用 setup-token 使用账号的电脑上设置：保存真实登录的那台机器的 SSH 主机名。设置后每 5 分钟从它同步一次账号用量（经过网络的只有用量数字，没有 token）。服务器本机请留空。"
        },
        "cswapStatus.showApi": {
          "type": "boolean",
          "default": true,
          "description": "显示 api-worker 的 Console API 花费和任务（状态栏条目和 cswap 侧栏里的 API Worker 视图）。关掉或没装 api-worker 时都不显示。"
        },
        "cswapStatus.apiWorkerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "api-worker 命令的路径。留空 = 先找 ~/.local/bin/api-worker，再找 PATH。"
        },
        "cswapStatus.notifyOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "cswap 切换了账号时（自动切换或手动切换）弹一条通知（例如“cswap 自动切换 #2 → #3（个人上限）”）。打开 VS Code 后的第一次读取不会通知。"
        },
        "cswapStatus.statusBar": {
          "type": "string",
          "enum": [
            "compact",
            "full",
            "off"
          ],
          "default": "compact",
          "enumDescriptions": [
            "只显示账号号码、5h 用量和 API 剩余金额，详情在 cswap 侧栏",
            "像 0.5.0 以前一样显示机器名、账号名和全部用量",
            "不在状态栏显示，只用侧栏"
          ],
          "description": "状态栏显示多少内容。详情都在左侧活动栏的 cswap 侧栏里。"
        },
        "cswapStatus.accountsStyle": {
          "type": "string",
          "enum": [
            "auto",
            "rings",
            "list"
          ],
          "enumDescriptions": [
            "先用圆环卡片；某个窗口的网页面板加载不出来时，那个窗口自动改用列表（新窗口会再试圆环）",
            "总是圆环卡片（网页面板）。加载不出来时提示一次",
            "总是列表（VS Code 自带的列表，每行一个小圆环图标），不依赖网页面板"
          ],
          "default": "auto",
          "description": "账号面板的样式。"
        }
      }
    },
    "views": {
      "cswap": [
        {
          "type": "webview",
          "id": "cswapStatus.accounts",
          "name": "账号",
          "when": "!cswapStatus.accountsList"
        },
        {
          "id": "cswapStatus.accountsList",
          "name": "账号",
          "when": "cswapStatus.accountsList"
        },
        {
          "id": "cswapStatus.auto",
          "name": "自动切换"
        },
        {
          "id": "cswapStatus.api",
          "name": "API Worker",
          "when": "config.cswapStatus.showApi && cswapStatus.apiAvailable"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "cswapStatus.addAccount",
          "when": "view == cswapStatus.accounts || view == cswapStatus.accountsList",
          "group": "navigation@0"
        },
        {
          "command": "cswapStatus.refresh",
          "when": "view == cswapStatus.accounts || view == cswapStatus.accountsList",
          "group": "navigation@1"
        },
        {
          "command": "cswapStatus.dashboard",
          "when": "view == cswapStatus.accounts || view == cswapStatus.accountsList",
          "group": "navigation@2"
        },
        {
          "command": "cswapStatus.startInTmux",
          "when": "view == cswapStatus.accounts || view == cswapStatus.accountsList",
          "group": "more@2"
        },
        {
          "command": "cswapStatus.continueInTmux",
          "when": "view == cswapStatus.accounts || view == cswapStatus.accountsList",
          "group": "more@3"
        },
        {
          "command": "cswapStatus.refresh",
          "when": "view == cswapStatus.auto",
          "group": "navigation@1"
        },
        {
          "command": "cswapStatus.autoPause",
          "when": "view == cswapStatus.auto && cswapAuto.canPause",
          "group": "navigation@2"
        },
        {
          "command": "cswapStatus.autoThreshold",
          "when": "view == cswapStatus.auto",
          "group": "more@1"
        },
        {
          "command": "cswapStatus.autoResume",
          "when": "view == cswapStatus.auto && cswapAuto.paused",
          "group": "navigation@2"
        },
        {
          "command": "cswapStatus.apiDispatch",
          "when": "view == cswapStatus.api",
          "group": "navigation@1"
        },
        {
          "command": "cswapStatus.apiRefresh",
          "when": "view == cswapStatus.api",
          "group": "navigation@2"
        },
        {
          "command": "cswapStatus.apiKeyAdd",
          "when": "view == cswapStatus.api",
          "group": "more@1"
        }
      ],
      "view/item/context": [
        {
          "command": "cswapStatus.autoThreshold",
          "when": "view == cswapStatus.auto && viewItem == cswapAuto.threshold",
          "group": "inline"
        },
        {
          "command": "cswapStatus.autoPause",
          "when": "view == cswapStatus.auto && viewItem == cswapAuto.pausable",
          "group": "inline"
        },
        {
          "command": "cswapStatus.autoResume",
          "when": "view == cswapStatus.auto && viewItem == cswapAuto.paused",
          "group": "inline"
        },
        {
          "command": "cswapStatus.apiOpenResult",
          "when": "view == cswapStatus.api && viewItem =~ /^apiTask\\./",
          "group": "1@1"
        },
        {
          "command": "cswapStatus.apiCancel",
          "when": "view == cswapStatus.api && viewItem =~ /^apiTask\\.api\\.(queued|running)$/",
          "group": "1@2"
        },
        {
          "command": "cswapStatus.apiOpenSession",
          "when": "view == cswapStatus.api && viewItem =~ /^apiTask\\.cloud\\./",
          "group": "1@3"
        },
        {
          "command": "cswapStatus.apiCollect",
          "when": "view == cswapStatus.api && viewItem == apiTask.cloud.done",
          "group": "1@4"
        },
        {
          "command": "cswapStatus.apiClose",
          "when": "view == cswapStatus.api && viewItem =~ /^apiTask\\.cloud\\.(cloud|running)$/",
          "group": "1@5"
        },
        {
          "command": "cswapStatus.apiKeyAdd",
          "when": "view == cswapStatus.api && viewItem == apiKeys",
          "group": "inline"
        },
        {
          "command": "cswapStatus.apiKeyBudget",
          "when": "view == cswapStatus.api && viewItem == apiKey",
          "group": "1@1"
        },
        {
          "command": "cswapStatus.apiKeyRemove",
          "when": "view == cswapStatus.api && viewItem == apiKey",
          "group": "9@1"
        },
        {
          "command": "cswapStatus.switchAccount",
          "when": "view == cswapStatus.accountsList && viewItem =~ /^cswapAccount/ && viewItem =~ /kind-other/",
          "group": "1_switch@1"
        },
        {
          "command": "cswapStatus.accountAlias",
          "when": "view == cswapStatus.accountsList && viewItem =~ /^cswapAccount/ && viewItem =~ /kind-(active|other|unswitchable)/",
          "group": "2_edit@1"
        },
        {
          "command": "cswapStatus.accountLimits",
          "when": "view == cswapStatus.accountsList && viewItem =~ /^cswapAccount/ && viewItem =~ /kind-(active|other|unswitchable)/",
          "group": "2_edit@2"
        },
        {
          "command": "cswapStatus.accountReserveOn",
          "when": "view == cswapStatus.accountsList && viewItem =~ /^cswapAccount/ && viewItem =~ /kind-(active|other|unswitchable)/ && !(viewItem =~ /reserve/)",
          "group": "2_edit@3"
        },
        {
          "command": "cswapStatus.accountReserveOff",
          "when": "view == cswapStatus.accountsList && viewItem =~ /^cswapAccount/ && viewItem =~ /reserve/",
          "group": "2_edit@3"
        },
        {
          "command": "cswapStatus.accountDisable",
          "when": "view == cswapStatus.accountsList && viewItem =~ /^cswapAccount/ && viewItem =~ /kind-(active|other|unswitchable)/ && viewItem =~ / on/",
          "group": "3_rotation@1"
        },
        {
          "command": "cswapStatus.accountEnable",
          "when": "view == cswapStatus.accountsList && viewItem =~ /^cswapAccount/ && viewItem =~ / off/",
          "group": "3_rotation@1"
        },
        {
          "command": "cswapStatus.accountRelogin",
          "when": "view == cswapStatus.accountsList && viewItem =~ /^cswapAccount/ && viewItem =~ /kind-(active|other|unswitchable)/",
          "group": "8_login@1"
        },
        {
          "command": "cswapStatus.accountRemove",
          "when": "view == cswapStatus.accountsList && viewItem =~ /^cswapAccount/ && viewItem =~ /kind-(active|other|unswitchable)/",
          "group": "9_remove@1"
        },
        {
          "command": "cswapStatus.switchAccount",
          "when": "view == cswapStatus.accountsList && viewItem =~ /kind-other/ && !(viewItem =~ /limit|relogin/)",
          "group": "inline"
        },
        {
          "command": "cswapStatus.accountRelogin",
          "when": "view == cswapStatus.accountsList && viewItem =~ /relogin/",
          "group": "inline"
        }
      ],
      "webview/context": [
        {
          "command": "cswapStatus.switchAccount",
          "when": "webviewId == 'cswapStatus.accounts' && webviewSection == 'account' && cswapKind == 'other'",
          "group": "1_switch@1"
        },
        {
          "command": "cswapStatus.accountAlias",
          "when": "webviewId == 'cswapStatus.accounts' && webviewSection == 'account' && cswapKind != 'none'",
          "group": "2_edit@1"
        },
        {
          "command": "cswapStatus.accountLimits",
          "when": "webviewId == 'cswapStatus.accounts' && webviewSection == 'account' && cswapKind != 'none'",
          "group": "2_edit@2"
        },
        {
          "command": "cswapStatus.accountReserveOn",
          "when": "webviewId == 'cswapStatus.accounts' && webviewSection == 'account' && cswapKind != 'none' && !cswapReserve",
          "group": "2_edit@3"
        },
        {
          "command": "cswapStatus.accountReserveOff",
          "when": "webviewId == 'cswapStatus.accounts' && webviewSection == 'account' && cswapReserve",
          "group": "2_edit@3"
        },
        {
          "command": "cswapStatus.accountDisable",
          "when": "webviewId == 'cswapStatus.accounts' && webviewSection == 'account' && cswapKind != 'none' && cswapOn",
          "group": "3_rotation@1"
        },
        {
          "command": "cswapStatus.accountEnable",
          "when": "webviewId == 'cswapStatus.accounts' && webviewSection == 'account' && !cswapOn",
          "group": "3_rotation@1"
        },
        {
          "command": "cswapStatus.accountRelogin",
          "when": "webviewId == 'cswapStatus.accounts' && webviewSection == 'account' && cswapKind != 'none'",
          "group": "8_login@1"
        },
        {
          "command": "cswapStatus.accountRemove",
          "when": "webviewId == 'cswapStatus.accounts' && webviewSection == 'account' && cswapKind != 'none'",
          "group": "9_remove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "cswapStatus.switchAccount",
          "when": "false"
        },
        {
          "command": "cswapStatus.apiOpenResult",
          "when": "false"
        },
        {
          "command": "cswapStatus.apiCancel",
          "when": "false"
        },
        {
          "command": "cswapStatus.apiClose",
          "when": "false"
        },
        {
          "command": "cswapStatus.apiOpenSession",
          "when": "false"
        },
        {
          "command": "cswapStatus.apiCollect",
          "when": "false"
        },
        {
          "command": "cswapStatus.accountEnable",
          "when": "false"
        },
        {
          "command": "cswapStatus.accountDisable",
          "when": "false"
        },
        {
          "command": "cswapStatus.accountAlias",
          "when": "false"
        },
        {
          "command": "cswapStatus.accountLimits",
          "when": "false"
        },
        {
          "command": "cswapStatus.accountReserveOn",
          "when": "false"
        },
        {
          "command": "cswapStatus.accountReserveOff",
          "when": "false"
        },
        {
          "command": "cswapStatus.accountRemove",
          "when": "false"
        },
        {
          "command": "cswapStatus.accountRelogin",
          "when": "false"
        },
        {
          "command": "cswapStatus.apiKeyBudget",
          "when": "false"
        },
        {
          "command": "cswapStatus.apiKeyRemove",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cswap",
          "title": "cswap",
          "icon": "media/cswap.svg"
        }
      ]
    }
  },
  "scripts": {
    "test": "for t in test/*.test.js; do node \"$t\" || exit 1; done"
  }
}
